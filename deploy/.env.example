# 复制为 .env 后修改；不要提交到版本库
# 用于签发登录 Cookie 的密钥，务必换成随机长串：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-string

# 走 HTTPS 时设为 true（Cookie 加 Secure）；纯 HTTP 调试用 false
COOKIE_SECURE=true

# 是否必须邀请码才能注册；首个注册用户自动成为管理员
INVITE_REQUIRED=true

# 数据库路径（容器内路径，对应 compose 的 /app/data 挂载）
DB_PATH=/app/data/gold.db

TZ=Asia/Shanghai
